# ==============================================================================
# SECURITY & SECRETS (Prevent Credential, Token, Key & Env Leaks)
# ==============================================================================
# Environment variable files and local secrets
.env
.env.*
!.env.example
!.env.template
*.env
*.secret
*.secrets
*.token
*.auth

# Cryptographic Keys, Certificates & Keystores
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cer
*.crt
*.der
*.keystore
*.jks
*.kdb
*.csr

# SSH & GPG Keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
known_hosts
authorized_keys
*.gpg
*.asc
secring.*
pubring.*

# Cloud Provider & Service Credentials
.aws/
.gcp/
.azure/
.kube/
kubeconfig
*kubeconfig*
*service-account*.json
*service_account*.json
*credentials*.json
client_secret*.json
