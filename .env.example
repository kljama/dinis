# InfluxDB 3 Core configuration
INFLUXDB3_URL=http://influxdb3:8181
INFLUXDB3_BUCKET=dinis
# InfluxDB 3 token (optional; if set, MUST start with 'apiv3_')
INFLUXDB3_TOKEN=
INFLUXDB3_NODE_ID=dinis-node

# Dinis configuration
DINIS_PORT=8080
DINIS_DATA=/data/dinis.json

# Grafana configuration
GRAFANA_ADMIN_PASSWORD=admin
